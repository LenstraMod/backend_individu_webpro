generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Product {
    id                 String  @id @default(uuid())
    productName        String
    productDescription String  @db.Text
    productPrice       Decimal @db.Decimal(10, 2)
    category           String?
    imageUrl           String?

    @@map("products")
}
